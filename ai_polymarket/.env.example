# Base URL of the AI demo backend. All demo-hosted endpoints (signup, Anthropic
# proxy, Gemini proxy) are derived from this single value.
AI_DEMO_BACKEND=https://demo.deltastream.io
DELTASTREAM_MCP_URL=https://api-kd8j38.stage.deltastream-internal.name/mcp/v2
ANTHROPIC_API_KEY=
INSECURE_DEMO_TLS=false

# Provider is selected by the MODEL_NAME prefix.
# Gemini (default):
MODEL_NAME=google:gemini-3.5-flash
# Anthropic (optional) - switch to route through the /anthropic gateway instead:
# MODEL_NAME=anthropic:claude-sonnet-4-6
# Gemini is a thinking model; reasoning tokens share the output budget and dynamic
# thinking can dominate latency. Use thinking level for 3.x models, or a thinking
# budget for 2.5 models.
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_LEVEL=low
# GEMINI_THINKING_BUDGET=512

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
QUERY_LIMIT=250
PRIMARY_QUERY_LIMIT=500
QUICK_MODE_ENABLED=true
QUICK_MODE_MAX_ATTEMPTS=2
QUICK_MODE_MAX_TOKENS=1400
QUICK_MODE_TIMEOUT_SECONDS=60

# Seconds of SSE inactivity before sending a keepalive comment on the chat stream.
# Lower this if a proxy/gateway closes the stream during long model generations.
SSE_HEARTBEAT_SECONDS=5

# Path prefix the app is served under when the Ingress does NOT strip the prefix
# before forwarding to the pod. Must start with '/' and must NOT end with '/'.
# Leave empty (default) for root deployments or when the Ingress strips the prefix.
# Example: ROOT_PATH=/polymarket
ROOT_PATH=
